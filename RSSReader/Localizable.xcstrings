    "settings.updatesSync.preference.disabled.subtitle" : {
      "comment" : "Subtitle for disabled iCloud sync preference.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies on next launch. When this setting is disabled, all syncable data stays on the device."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применится при следующем запуске. При отключении настройки все синхронизируемые данные останутся на устройстве."
          }
        },
        "ja" : {
          "stringUnit" : {
