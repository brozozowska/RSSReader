    "settings.syncStatus.couldNotDetermine.subtitle" : {
      "comment" : "Status subtitle when iCloud account status could not be determined.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على التطبيق تحديد حالة حساب iCloud الحالي. تحقق من توفر Apple ID وiCloud للجهاز، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App konnte den aktuellen Status des iCloud-Accounts nicht ermitteln. Prüfe die Apple-ID und die iCloud-Verfügbarkeit auf dem Gerät und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app could not determine the current iCloud account status. Check the device Apple ID and iCloud availability, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app no pudo determinar el estado actual de la cuenta de iCloud. Comprueba el Apple ID del dispositivo y la disponibilidad de iCloud, y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه نتوانست وضعیت حساب فعلی iCloud را تعیین کند. Apple ID دستگاه و دسترس‌پذیری iCloud را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app n’a pas pu déterminer l’état du compte iCloud actuel. Vérifiez l’identifiant Apple de l’appareil et la disponibilité d’iCloud, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה לא הצליחה לקבוע את מצב חשבון iCloud הנוכחי. בדוק את Apple ID במכשיר ואת זמינות iCloud, ואז נסה שוב."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app non ha potuto determinare lo stato attuale dell’account iCloud. Controlla l’Apple ID del dispositivo e la disponibilità di iCloud, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の iCloud アカウント状態を判定できませんでした。デバイスの Apple ID と iCloud の利用可否を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 현재 iCloud 계정 상태를 확인할 수 없습니다. 기기의 Apple ID와 iCloud 사용 가능 여부를 확인한 뒤 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app não conseguiu determinar o estado atual da conta do iCloud. Verifique o Apple ID do dispositivo e a disponibilidade do iCloud, depois tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение не смогло определить состояние текущего аккаунта iCloud. Проверьте Apple ID на устройстве и доступность iCloud, затем попробуйте ещё раз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ موجودہ iCloud اکاؤنٹ کی حالت معلوم نہیں کر سکی۔ ڈیوائس کا Apple ID اور iCloud کی دستیابی چیک کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用无法确定当前 iCloud 帐户状态。请检查设备 Apple ID 和 iCloud 可用性，然后重试。"
          }
        }
      }
    },
