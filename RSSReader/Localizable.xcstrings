    "settings.alert.clearArticleImageCache.message" : {
      "comment" : "Confirmation alert message for clearing cached article images.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى إزالة صور المقالة المحفوظة على هذا الجهاز. يمكن تنزيل الصور مرة أخرى عند فتح المقالات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden auf diesem Gerät gespeicherte Artikelbilder entfernt. Bilder können erneut geladen werden, wenn Artikel geöffnet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes article images saved on this device. Images can be downloaded again when articles are opened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción borrará las imágenes de artículos guardadas en este dispositivo. Podrán descargarse de nuevo al abrir los artículos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار تصویرهای ذخیره‌شدهٔ مقاله‌ها را از این دستگاه حذف می‌کند. با باز کردن مقاله‌ها می‌توان تصویرها را دوباره دانلود کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette opération supprimera les images d’articles enregistrées sur cet appareil. Elles pourront être téléchargées de nouveau à l’ouverture des articles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תמחק תמונות כתבות שנשמרו במכשיר הזה. אפשר להוריד אותן שוב כשפותחים כתבות."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione eliminerà le immagini degli articoli salvate su questo dispositivo. Potranno essere scaricate di nuovo quando apri gli articoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスに保存された記事画像を削除します。記事を開くと画像を再度ダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 저장된 기사 이미지를 제거합니다. 기사를 열면 이미지를 다시 다운로드할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação removerá as imagens de artigos salvas neste dispositivo. Elas poderão ser baixadas novamente quando os artigos forem abertos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображения статей, сохранённые на этом устройстве, будут удалены. Они могут быть загружены снова при открытии статей."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ اس ڈیوائس پر محفوظ مضمون کی تصاویر ہٹا دے گا۔ مضامین کھولنے پر تصاویر دوبارہ ڈاؤن لوڈ ہو سکتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
