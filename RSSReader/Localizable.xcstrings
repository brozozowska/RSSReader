    "settings.articleList.section.footer" : {
      "comment" : "Footer explaining archived article retention settings.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"None\" removes an article from the list as soon as it disappears from its feed. Other options keep the article for the selected time after it disappears from the feed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опция «Нет» удаляет статью из списка сразу как она пропадает из выдачи ленты. Другие опции позволяют хранить статью выбранное время после её пропажи из выдачи."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「なし」は、記事がフィードから消えた時点でリストから削除します。ほかのオプションは、記事がフィードから消えた後も選択した期間だけ保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“无”会在文章从订阅源中消失后立即将其从列表中移除。其他选项会在文章从订阅源中消失后按所选时间继续保留。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“없음”은 기사가 피드에서 사라지면 즉시 목록에서 제거합니다. 다른 옵션은 기사가 피드에서 사라진 뒤 선택한 기간 동안 유지합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي الخيار \"لا شيء\" إلى إزالة المقالة من القائمة بمجرد اختفائها من خلاصتها. تحتفظ الخيارات الأخرى بالمقالة للوقت المحدد بعد اختفائها من الخلاصة."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״ללא״ מסיר כתבה מהרשימה מיד כשהיא נעלמת מהפיד שלה. האפשרויות האחרות שומרות את הכתבה למשך הזמן שנבחר אחרי שהיא נעלמת מהפיד."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«هیچ‌کدام» مقاله را به‌محض ناپدید شدن از فیدش از فهرست حذف می‌کند. گزینه‌های دیگر مقاله را پس از ناپدید شدن از فید، تا مدت انتخاب‌شده نگه می‌دارند."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"کوئی نہیں\" مضمون کو اس کی فیڈ سے غائب ہوتے ہی فہرست سے ہٹا دیتا ہے۔ دوسرے اختیارات مضمون کو فیڈ سے غائب ہونے کے بعد منتخب مدت تک رکھتے ہیں۔"
          }
        }
      }
    },
