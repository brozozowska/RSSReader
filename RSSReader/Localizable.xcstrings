    "settings.alert.clearFeedIconCache.message" : {
      "comment" : "Confirmation alert message for clearing cached feed icons.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة أيقونات الخلاصة المحفوظة على هذا الجهاز. يمكن اكتشافها وتنزيلها مرة أخرى عند تشغيل التحديث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät gespeicherte Feed-Symbole werden entfernt. Sie können bei einer Aktualisierung erneut gefunden und geladen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feed icons saved on this device will be removed. They can be discovered and downloaded again when refresh runs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán los iconos de fuentes guardados en este dispositivo. Podrán detectarse y descargarse de nuevo al actualizar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیکون‌های فید ذخیره‌شده روی این دستگاه حذف می‌شوند. هنگام تازه‌سازی می‌توان آن‌ها را دوباره پیدا و دانلود کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les icônes de flux enregistrées sur cet appareil seront supprimées. Elles pourront être retrouvées et téléchargées de nouveau lors d’une actualisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איקוני פידים שנשמרו במכשיר הזה יימחקו. אפשר למצוא ולהוריד אותם שוב בזמן רענון."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le icone delle fonti salvate su questo dispositivo verranno eliminate. Potranno essere trovate e scaricate di nuovo durante un aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスに保存されたフィードアイコンを削除します。更新時に再検出してダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 저장된 피드 아이콘이 제거됩니다. 새로 고침이 실행되면 다시 찾아 다운로드할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ícones de feeds salvos neste dispositivo serão removidos. Eles poderão ser encontrados e baixados novamente durante uma atualização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иконки лент, сохранённые на этом устройстве, будут удалены. Они могут быть найдены и загружены снова при запуске обновления."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ڈیوائس پر محفوظ فیڈ آئیکنز ہٹا دیے جائیں گے۔ تازہ کاری کے دوران انہیں دوبارہ تلاش اور ڈاؤن لوڈ کیا جا سکتا ہے۔"
