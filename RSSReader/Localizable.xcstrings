    "sidebar.unsubscribeConfirmation.message" : {
      "comment" : "Alert message asking the user to confirm unsubscribing from a feed. The placeholder is the feed title.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد إلغاء الاشتراك في «%@»؟ ستُزال مقالات هذه الخلاصة من هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ abbestellen? Artikel aus diesem Feed werden von diesem Gerät entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsubscribe from \"%@\"? Articles from this feed will be removed from this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cancelar la suscripción a «%@»? Los artículos de esta fuente se eliminarán de este dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشتراک «%@» لغو شود؟ مقاله‌های این فید از این دستگاه حذف می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous désabonner de « %@ » ? Les articles de ce flux seront supprimés de cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לבטל את ההרשמה ל־\"%@\"? הכתבות מהפיד הזה יוסרו מהמכשיר הזה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annullare l’iscrizione a “%@”? Gli articoli di questa fonte verranno rimossi da questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”の購読を解除しますか？このフィードの記事はこのデバイスから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 구독을 해지할까요? 이 피드의 기사가 이 기기에서 제거됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar assinatura de “%@”? Os artigos deste feed serão removidos deste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отписаться от «%@»? Статьи из этой ленты будут удалены с этого устройства."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» کی رکنیت ختم کریں؟ اس فیڈ کے مضامین اس آلے سے ہٹا دیے جائیں گے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要退订“%@”吗？此订阅源中的文章将从这台设备移除。"
          }
        }
      }
    },
