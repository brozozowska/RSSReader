    "settings.updatesSync.preference.disabled.subtitle" : {
      "comment" : "Subtitle for disabled iCloud sync preference.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies on next launch. When this setting is disabled, all syncable data stays on the device."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применится при следующем запуске. При отключении настройки все синхронизируемые данные останутся на устройстве."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回起動時に適用されます。この設定を無効にすると、同期可能なすべてのデータはデバイス上に残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次启动时生效。禁用此设置后，所有可同步数据都会保留在设备上。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 실행 시 적용됩니다. 이 설정을 끄면 동기화 가능한 모든 데이터가 기기에 남습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق على الإطلاق المقبل. عند تعطيل هذا الإعداد، تظل جميع البيانات القابلة للمزامنة على الجهاز."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יחול בהפעלה הבאה. כשהגדרה זו כבויה, כל הנתונים שניתן לסנכרן נשארים במכשיר."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در اجرای بعدی اعمال می‌شود. وقتی این تنظیم خاموش باشد، همهٔ داده‌های قابل همگام‌سازی روی دستگاه می‌مانند."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگلے آغاز پر لاگو ہو گا۔ جب یہ ترتیب غیر فعال ہو، تمام ہم وقت ہونے والا ڈیٹا ڈیوائس پر رہتا ہے۔"
          }
        }
      }
    },
    "settings.updatesSync.preference.enabled.subtitle" : {
      "comment" : "Subtitle for enabled iCloud sync preference.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
