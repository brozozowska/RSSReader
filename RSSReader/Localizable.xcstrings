    "feedManagement.summary.description" : {
      "comment" : "Summary description on the feed management entry screen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscribe to new feeds, create folders, and organize feed storage for easier reading."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписывайтесь на новые ленты, создавайте папки и организовывайте в них хранение для удобства чтения."
          }
        },
        "ja" : {
          "stringUnit" : {
