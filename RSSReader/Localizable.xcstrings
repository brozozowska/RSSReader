    "settings.syncStatus.fallback.couldNotDetermine.subtitle" : {
      "comment" : "Status subtitle for local-only fallback when iCloud availability could not be confirmed.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المزامنة مفعّلة، لكن هذا التشغيل لم يتمكن من تأكيد توفر iCloud. أعد تشغيل التطبيق بعد توفر iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung ist aktiviert, aber dieser Start konnte die iCloud-Verfügbarkeit nicht bestätigen. Starte die App neu, sobald iCloud verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is enabled, but this launch could not confirm iCloud availability. Relaunch after iCloud becomes available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización está activada, pero este inicio no pudo confirmar la disponibilidad de iCloud. Reinicia la app cuando iCloud esté disponible."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همگام‌سازی روشن است، اما در این اجرا در دسترس بودن iCloud تأیید نشد. پس از در دسترس شدن iCloud برنامه را دوباره باز کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation est activée, mais ce lancement n’a pas pu confirmer la disponibilité d’iCloud. Relancez l’app quand iCloud sera disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסנכרון מופעל, אבל בהפעלה הזו לא ניתן היה לאשר ש-iCloud זמין. הפעל מחדש אחרי ש-iCloud יהיה זמין."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione è attiva, ma questo avvio non ha potuto confermare la disponibilità di iCloud. Riavvia l’app quando iCloud sarà disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期は有効ですが、この起動では iCloud の利用可否を確認できませんでした。iCloud が利用可能になった後で再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화가 켜져 있지만 이번 실행에서는 iCloud 사용 가능 여부를 확인할 수 없습니다. iCloud를 사용할 수 있게 된 뒤 다시 실행하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização está ativada, mas esta sessão não conseguiu confirmar a disponibilidade do iCloud. Reinicie o app quando o iCloud estiver disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация включена, но при этом запуске не удалось подтвердить доступность iCloud. Перезапустите приложение, когда iCloud станет доступен."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہم وقت سازی فعال ہے، لیکن اس بار iCloud کی دستیابی کی تصدیق نہیں ہو سکی۔ iCloud دستیاب ہونے کے بعد ایپ دوبارہ کھولیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已启用，但本次启动无法确认 iCloud 可用性。请在 iCloud 可用后重新启动。"
          }
        }
      }
    },
