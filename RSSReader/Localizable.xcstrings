    "settings.notifications.section.footer" : {
      "comment" : "Footer explaining notification permission usage for the app icon badge.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app does not send notifications, but iOS still requires notification permission to show a badge on the app icon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение не отправляет уведомлений, но iOS всё равно требует разрешения на их отправку, чтобы показывать бейдж на значке приложения."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリは通知を送信しませんが、iOS ではアプリアイコンにバッジを表示するためにも通知権限が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用不会发送通知，但 iOS 仍需要通知权限才能在应用图标上显示角标。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 알림을 보내지 않지만, iOS는 앱 아이콘에 배지를 표시하기 위해서도 알림 권한을 요구합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يرسل التطبيق إشعارات، لكن نظام iOS لا يزال يتطلب إذنًا للإشعارات لإظهار شارة على أيقونة التطبيق."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה לא שולחת התראות, אבל iOS עדיין דורשת הרשאת התראות כדי להציג תג על איקון האפליקציה."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه اعلان نمی‌فرستد، اما iOS برای نمایش نشان روی آیکون برنامه همچنان به مجوز اعلان نیاز دارد."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ اطلاعات نہیں بھیجتی، لیکن iOS کو ایپ آئیکن پر بیج دکھانے کے لیے اطلاعات کی اجازت پھر بھی چاہیے۔"
          }
        }
      }
    },
