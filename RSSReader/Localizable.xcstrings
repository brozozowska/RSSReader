    "settings.opmlImportPreview.description" : {
      "comment" : "Description in the OPML import preview sheet.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App found feeds in the selected OPML file. Check the summary before adding them to your feed list."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение нашло ленты в выбранном OPML-файле. Проверьте сводку перед добавлением в список лент."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した OPML ファイル内にフィードが見つかりました。フィードリストに追加する前に概要を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用在所选 OPML 文件中找到了订阅源。添加到订阅源列表前请先查看摘要。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 OPML 파일에서 피드를 찾았습니다. 피드 목록에 추가하기 전에 요약을 확인하세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عثر التطبيق على خلاصات في ملف OPML المحدد. راجع الملخص قبل إضافتها إلى قائمة الخلاصات."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה מצאה פידים בקובץ OPML שנבחר. בדוק את הסיכום לפני ההוספה לרשימת הפידים שלך."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه در فایل OPML انتخاب‌شده فیدهایی پیدا کرد. پیش از افزودن آن‌ها به فهرست فیدها، خلاصه را بررسی کنید."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ نے منتخب OPML فائل میں فیڈز ڈھونڈ لی ہیں۔ انہیں اپنی فیڈز کی فہرست میں شامل کرنے سے پہلے خلاصہ دیکھ لیں۔"
          }
        }
      }
    },
    "settings.opmlImportPreview.footer" : {
      "comment" : "Footer in the OPML import preview sheet.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invalid and duplicate feeds are skipped automatically. Existing folders are reused; missing folders are created during import."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некорректные и повторяющиеся ленты пропускаются автоматически. Существующие папки используются повторно, недостающие создаются при импорте."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無効なフィードと重複フィードは自動的にスキップされます。既存のフォルダは再利用され、不足しているフォルダはインポート時に作成されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无效和重复的订阅源会自动跳过。现有文件夹会被复用；缺少的文件夹会在导入时创建。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유효하지 않거나 중복된 피드는 자동으로 건너뜁니다. 기존 폴더는 재사용하고, 없는 폴더는 가져오는 동안 생성합니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تخطي الخلاصات غير الصالحة والمكررة تلقائيًا. تتم إعادة استخدام المجلدات الموجودة؛ يتم إنشاء المجلدات المفقودة أثناء الاستيراد."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פידים לא תקינים וכפולים ידולגו אוטומטית. תיקיות קיימות ישמשו מחדש; תיקיות חסרות ייווצרו במהלך הייבוא."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فیدهای نامعتبر و تکراری خودکار رد می‌شوند. پوشه‌های موجود دوباره استفاده می‌شوند؛ پوشه‌های ناموجود هنگام وارد کردن ساخته می‌شوند."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نامعتبر اور مکرر فیڈز خود بخود چھوڑ دی جائیں گی۔ موجودہ فولڈرز دوبارہ استعمال ہوں گے؛ جو فولڈرز موجود نہ ہوں وہ درآمد کے دوران بن جائیں گے۔"
          }
        }
      }
    },
