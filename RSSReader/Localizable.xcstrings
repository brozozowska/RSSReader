    "settings.articleList.section.footer" : {
      "comment" : "Footer explaining archived article retention settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي الخيار \"لا شيء\" إلى إزالة المقالة من القائمة بمجرد اختفائها من خلاصتها. تحتفظ الخيارات الأخرى بالمقالة للوقت المحدد بعد اختفائها من الخلاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Keine“ entfernt einen Artikel aus der Liste, sobald er aus seinem Feed verschwindet. Andere Optionen behalten den Artikel für die ausgewählte Zeit, nachdem er aus dem Feed verschwunden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"None\" removes an article from the list as soon as it disappears from its feed. Other options keep the article for the selected time after it disappears from the feed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ninguno» elimina un artículo de la lista en cuanto desaparece de su fuente. Las demás opciones conservan el artículo durante el tiempo elegido después de que desaparezca de la fuente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«هیچ‌کدام» مقاله را به‌محض ناپدید شدن از فیدش از فهرست حذف می‌کند. گزینه‌های دیگر مقاله را پس از ناپدید شدن از فید، تا مدت انتخاب‌شده نگه می‌دارند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Aucun » retire un article de la liste dès qu’il disparaît de son flux. Les autres options conservent l’article pendant la durée choisie après sa disparition du flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״ללא״ מסיר כתבה מהרשימה מיד כשהיא נעלמת מהפיד שלה. האפשרויות האחרות שומרות את הכתבה למשך הזמן שנבחר אחרי שהיא נעלמת מהפיד."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Nessuno” rimuove un articolo dall’elenco appena scompare dalla sua fonte. Le altre opzioni conservano l’articolo per il periodo scelto dopo la scomparsa dalla fonte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「なし」は、記事がフィードから消えた時点でリストから削除します。ほかのオプションは、記事がフィードから消えた後も選択した期間だけ保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“없음”은 기사가 피드에서 사라지면 즉시 목록에서 제거합니다. 다른 옵션은 기사가 피드에서 사라진 뒤 선택한 기간 동안 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Nenhum” remove um artigo da lista assim que ele desaparece do feed. As outras opções mantêm o artigo pelo período escolhido depois que ele desaparece do feed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опция «Нет» удаляет статью из списка сразу как она пропадает из выдачи ленты. Другие опции позволяют хранить статью выбранное время после её пропажи из выдачи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"کوئی نہیں\" مضمون کو اس کی فیڈ سے غائب ہوتے ہی فہرست سے ہٹا دیتا ہے۔ دوسرے اختیارات مضمون کو فیڈ سے غائب ہونے کے بعد منتخب مدت تک رکھتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“无”会在文章从订阅源中消失后立即将其从列表中移除。其他选项会在文章从订阅源中消失后按所选时间继续保留。"
          }
        }
      }
    },
