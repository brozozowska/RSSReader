      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المزامنة مفعّلة، لكن هذا التشغيل لا يستطيع استخدام iCloud لأن الوصول مقيد على هذا الجهاز. أعد تشغيل التطبيق بعد إزالة القيد."
          }
