        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplicará la próxima vez que se abra la app. Cuando este ajuste está desactivado, todos los datos sincronizables permanecen en el dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در اجرای بعدی اعمال می‌شود. وقتی این تنظیم خاموش باشد، همهٔ داده‌های قابل همگام‌سازی روی دستگاه می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique au prochain lancement. Lorsque ce réglage est désactivé, toutes les données synchronisables restent sur l’appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יחול בהפעלה הבאה. כשהגדרה זו כבויה, כל הנתונים שניתן לסנכרן נשארים במכשיר."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà applicata al prossimo avvio. Quando questa impostazione è disattivata, tutti i dati sincronizzabili restano sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回起動時に適用されます。この設定を無効にすると、同期可能なすべてのデータはデバイス上に残ります。"
