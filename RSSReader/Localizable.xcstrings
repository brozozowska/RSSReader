    "settings.syncStatus.restricted.subtitle" : {
      "comment" : "Status subtitle when iCloud access is restricted.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لهذا الجهاز استخدام iCloud الآن نظرًا لأن تغييرات الحساب أو الوصول إلى CloudKit مقيد."
