    "settings.syncStatus.fallback.temporarilyUnavailable.subtitle" : {
      "comment" : "Status subtitle for local-only fallback when iCloud is temporarily unavailable.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المزامنة مفعّلة، لكن هذا التشغيل لا يستطيع استخدام iCloud لأن الحساب الحالي غير متاح مؤقتًا. أعد تشغيل التطبيق عندما يصبح iCloud متاحًا."
