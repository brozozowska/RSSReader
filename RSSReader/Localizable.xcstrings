            "value" : "Subscribe to new feeds, create folders, and organize feed storage for easier reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suscríbete a nuevas fuentes, crea carpetas y organiza tus fuentes para leer con más facilidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در فیدهای جدید مشترک شوید، پوشه بسازید و فیدها را برای خواندن آسان‌تر سازمان‌دهی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
