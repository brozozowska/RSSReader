    },
    "settings.updatesSync.preference.fallback.subtitle" : {
      "comment" : "Subtitle for enabled iCloud sync preference when this launch uses local-only fallback. Placeholder is the fallback reason.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
