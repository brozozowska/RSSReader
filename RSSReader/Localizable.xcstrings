          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применится при следующем запуске. Поддерживаемые данные будут синхронизироваться через iCloud, когда он доступен."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回起動時に適用されます。対応データは iCloud が利用可能なときに同期されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
