          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Será aplicado na próxima vez que o app for aberto. Quando este ajuste está desativado, todos os dados sincronizáveis permanecem no dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применится при следующем запуске. При отключении настройки все синхронизируемые данные останутся на устройстве."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگلے آغاز پر لاگو ہو گا۔ جب یہ ترتیب غیر فعال ہو، تمام ہم وقت ہونے والا ڈیٹا ڈیوائس پر رہتا ہے۔"
