    "feedManagement.section.add.footer" : {
      "comment" : "Section footer for creating new feeds and folders.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with a feed address, or create a folder first if you already know how you want to organize feeds."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с адреса ленты или сначала создайте папку, если уже знаете, как хотите организовать ленты."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードアドレスから始めます。整理方法がすでに決まっている場合は、先にフォルダを作成できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从订阅源地址开始；如果已经知道如何整理订阅源，也可以先创建文件夹。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드 주소로 시작하거나, 피드를 어떻게 정리할지 이미 알고 있다면 먼저 폴더를 만드세요."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بعنوان الخلاصة، أو أنشئ مجلدًا أولًا إذا كنت تعرف كيف تريد تنظيم الخلاصات."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחל מכתובת פיד, או צור קודם תיקייה אם כבר ברור לך איך תרצה לארגן פידים."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با نشانی فید شروع کنید، یا اگر از قبل می‌دانید فیدها را چطور سازمان‌دهی می‌کنید ابتدا پوشه بسازید."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فیڈ کے پتے سے شروع کریں، یا اگر آپ کو پہلے سے معلوم ہے کہ فیڈز کیسے منظم کرنی ہیں تو پہلے فولڈر بنائیں۔"
          }
        }
      }
    },
