    "feedManagement.section.add.footer" : {
      "comment" : "Section footer for creating new feeds and folders.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بعنوان الخلاصة، أو أنشئ مجلدًا أولًا إذا كنت تعرف كيف تريد تنظيم الخلاصات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginne mit einer Feed-Adresse oder erstelle zuerst einen Ordner, wenn du bereits weißt, wie du Feeds organisieren möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with a feed address, or create a folder first if you already know how you want to organize feeds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con una dirección de fuente o crea primero una carpeta si ya sabes cómo quieres organizar tus fuentes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با نشانی فید شروع کنید، یا اگر از قبل می‌دانید فیدها را چطور سازمان‌دهی می‌کنید ابتدا پوشه بسازید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par une adresse de flux, ou créez d’abord un dossier si vous savez déjà comment organiser vos flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחל מכתובת פיד, או צור קודם תיקייה אם כבר ברור לך איך תרצה לארגן פידים."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia con l’indirizzo di una fonte oppure crea prima una cartella se sai già come vuoi organizzare le fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードアドレスから始めます。整理方法がすでに決まっている場合は、先にフォルダを作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드 주소로 시작하거나, 피드를 어떻게 정리할지 이미 알고 있다면 먼저 폴더를 만드세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com o endereço de um feed ou crie uma pasta primeiro se você já sabe como quer organizar os feeds."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с адреса ленты или сначала создайте папку, если уже знаете, как хотите организовать ленты."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فیڈ کے پتے سے شروع کریں، یا اگر آپ کو پہلے سے معلوم ہے کہ فیڈز کیسے منظم کرنی ہیں تو پہلے فولڈر بنائیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从订阅源地址开始；如果已经知道如何整理订阅源，也可以先创建文件夹。"
          }
        }
      }
