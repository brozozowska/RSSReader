    "settings.updatesSync.footer.account" : {
      "comment" : "Footer explaining iCloud sync scope and relaunch behavior in the Updates & Sync settings section.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App settings, feeds, folders, articles, and their states sync across devices using iCloud and your Apple ID. Article images and feed icons are stored separately on each device. Changing the sync setting applies on the next app launch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки приложения, ленты, папки, статьи и их состояния синхронизируются между устройствами при помощи iCloud и используют для этого ваш Apple ID. Изображения из статей и иконки лент сохраняются отдельно на каждом устройстве. Изменение настройки синхронизации применяется при следующем запуске приложения."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ設定、フィード、フォルダ、記事、およびそれらの状態は、iCloud と Apple ID を使ってデバイス間で同期されます。記事画像とフィードアイコンは各デバイスに個別に保存されます。同期設定の変更は次回のアプリ起動時に適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用设置、订阅源、文件夹、文章及其状态会使用 iCloud 和你的 Apple ID 在设备间同步。文章图片和订阅源图标会分别存储在每台设备上。更改同步设置会在下次启动应用时生效。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 설정, 피드, 폴더, 기사와 그 상태는 iCloud와 Apple ID를 사용해 기기 간에 동기화됩니다. 기사 이미지와 피드 아이콘은 각 기기에 별도로 저장됩니다. 동기화 설정 변경은 다음 앱 실행 시 적용됩니다."
          }
        }
      }
    },
    "settings.updatesSync.footer.fallback" : {
      "comment" : "Footer sentence shown when the current launch uses local-only sync fallback.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync will try again on the next launch when iCloud is available."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация повторит попытку при следующем запуске, когда iCloud будет доступен."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud が利用可能になった次回起動時に、同期を再試行します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次启动且 iCloud 可用时，同步会再次尝试。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 실행에서 iCloud를 사용할 수 있으면 동기화를 다시 시도합니다."
          }
        }
      }
    },
    "settings.updatesSync.footer.relaunch" : {
