    "settings.storage.clearArchivedArticles.subtitle" : {
      "comment" : "Button subtitle explaining archived article cleanup.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أزل المقالات المؤرشفة باستثناء المقالات المميزة بنجمة من هذا الجهاز ومن iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivierte Artikel außer solchen mit Stern von diesem Gerät und aus iCloud entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove archived articles except starred ones from this device and iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar de este dispositivo y de iCloud los artículos archivados, excepto los favoritos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقاله‌های بایگانی‌شده به‌جز ستاره‌دارها را از این دستگاه و iCloud حذف کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
