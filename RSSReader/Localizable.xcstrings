    "sidebar.folderDeleteConfirmation.message" : {
      "comment" : "Alert message asking the user to confirm deleting a folder. The placeholder is the folder name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد حذف «%@»؟ لن تُحذف الخلاصات داخل هذا المجلد. ستُنقل إلى «غير مصنفة»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ löschen? Feeds in diesem Ordner werden nicht gelöscht. Sie werden nach „Nicht gruppiert“ verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete \"%@\"? Feeds inside this folder will not be deleted. They will move to Ungrouped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar «%@»? Las fuentes dentro de esta carpeta no se eliminarán. Se moverán a «Sin carpeta»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پوشهٔ «%@» حذف شود؟ فیدهای داخل این پوشه حذف نمی‌شوند و به «بدون پوشه» منتقل می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer « %@ » ? Les flux de ce dossier ne seront pas supprimés. Ils seront déplacés vers « Sans dossier »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למחוק את \"%@\"? הפידים שבתיקייה הזו לא יימחקו. הם יועברו אל ״ללא תיקייה״."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare “%@”? Le fonti in questa cartella non verranno eliminate. Verranno spostate in “Senza cartella”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”を削除しますか？このフォルダ内のフィードは削除されず、「未分類」に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 폴더를 삭제할까요? 이 폴더 안의 피드는 삭제되지 않고 ‘그룹 없음’으로 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir “%@”? Os feeds dentro desta pasta não serão excluídos. Eles serão movidos para “Sem pasta”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить «%@»? Ленты в этой папке не будут удалены. Они переместятся в «Без папки»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» حذف کریں؟ اس فولڈر کے اندر موجود فیڈز حذف نہیں ہوں گی۔ وہ «بغیر فولڈر» میں منتقل ہو جائیں گی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要删除“%@”吗？此文件夹中的订阅源不会被删除，而是会移至“未分组”。"
          }
        }
      }
    },
