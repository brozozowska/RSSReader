    "settings.alert.clearArchivedArticles.message" : {
      "comment" : "Confirmation alert message for clearing archived articles.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes archived articles from this device and iCloud. Starred articles, current articles, and saved article images are not affected."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивные статьи будут удалены с этого устройства и из iCloud. Избранные статьи, текущие статьи и сохранённые изображения статей не изменятся."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブ済みの記事をこのデバイスと iCloud から削除します。スター付きの記事、現在の記事、保存済みの記事画像には影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从此设备和 iCloud 中移除已归档文章。已加星标的文章、当前文章和已保存的文章图片不会受影响。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관된 기사를 이 기기와 iCloud에서 제거합니다. 별표 표시한 기사, 현재 기사, 저장된 기사 이미지는 영향을 받지 않습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى إزالة المقالات المؤرشفة من هذا الجهاز ومن iCloud. لا تتأثر المقالات المميزة بنجمة والمقالات الحالية وصور المقالات المحفوظة."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תמחק כתבות בארכיון מהמכשיר הזה ומ-iCloud. כתבות מועדפות, כתבות נוכחיות ותמונות כתבות שמורות לא יושפעו."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار مقاله‌های بایگانی‌شده را از این دستگاه و iCloud حذف می‌کند. مقاله‌های ستاره‌دار، مقاله‌های فعلی و تصویرهای ذخیره‌شدهٔ مقاله‌ها دست‌نخورده می‌مانند."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ آرکائیو شدہ مضامین کو اس ڈیوائس اور iCloud سے ہٹا دے گا۔ پسندیدہ مضامین، موجودہ مضامین اور مضمون کی محفوظ تصاویر متاثر نہیں ہوں گی۔"
          }
        }
      }
    },
