    "settings.notifications.section.footer" : {
      "comment" : "Footer explaining notification permission usage for the app icon badge.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يرسل التطبيق إشعارات، لكن نظام iOS لا يزال يتطلب إذنًا للإشعارات لإظهار شارة على أيقونة التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App sendet keine Mitteilungen, aber iOS verlangt trotzdem eine Mitteilungsberechtigung, um ein Badge auf dem App-Symbol anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app does not send notifications, but iOS still requires notification permission to show a badge on the app icon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app no envía notificaciones, pero iOS necesita permiso de notificaciones para mostrar un globo en el icono de la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه اعلان نمی‌فرستد، اما iOS برای نمایش نشان روی آیکون برنامه همچنان به مجوز اعلان نیاز دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app n’envoie pas de notifications, mais iOS exige tout de même l’autorisation des notifications pour afficher une pastille sur l’icône de l’app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה לא שולחת התראות, אבל iOS עדיין דורשת הרשאת התראות כדי להציג תג על איקון האפליקציה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app non invia notifiche, ma iOS richiede comunque l’autorizzazione alle notifiche per mostrare un badge sull’icona dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリは通知を送信しませんが、iOS ではアプリアイコンにバッジを表示するためにも通知権限が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 알림을 보내지 않지만, iOS는 앱 아이콘에 배지를 표시하기 위해서도 알림 권한을 요구합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app não envia notificações, mas o iOS ainda exige permissão de notificações para mostrar o contador no ícone do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение не отправляет уведомлений, но iOS всё равно требует разрешения на их отправку, чтобы показывать бейдж на значке приложения."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ اطلاعات نہیں بھیجتی، لیکن iOS کو ایپ آئیکن پر بیج دکھانے کے لیے اطلاعات کی اجازت پھر بھی چاہیے۔"
          }
        },
        "zh-Hans" : {
