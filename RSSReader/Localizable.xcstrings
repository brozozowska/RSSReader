    "settings.syncStatus.fallback.noAccount.subtitle" : {
      "comment" : "Status subtitle for local-only fallback when iCloud sign-in is missing.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المزامنة مفعّلة، لكن هذا التشغيل لا يستطيع استخدام iCloud لأن الجهاز غير مسجل الدخول. سجّل الدخول ثم أعد تشغيل التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung ist aktiviert, aber dieser Start kann iCloud nicht verwenden, weil das Gerät nicht angemeldet ist. Starte die App nach der Anmeldung neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is enabled, but this launch cannot use iCloud because the device is not signed in. Relaunch after signing in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización está activada, pero este inicio no puede usar iCloud porque el dispositivo no ha iniciado sesión. Inicia sesión y reinicia la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همگام‌سازی روشن است، اما در این اجرا چون دستگاه وارد iCloud نشده نمی‌توان از iCloud استفاده کرد. وارد شوید و برنامه را دوباره باز کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation est activée, mais ce lancement ne peut pas utiliser iCloud car l’appareil n’est pas connecté. Connectez-vous, puis relancez l’app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסנכרון מופעל, אבל בהפעלה הזו אי אפשר להשתמש ב-iCloud כי המכשיר לא מחובר. התחבר והפעל מחדש."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione è attiva, ma questo avvio non può usare iCloud perché il dispositivo non ha effettuato l’accesso. Accedi e riavvia l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期は有効ですが、このデバイスでサインインしていないため、この起動では iCloud を使用できません。サインイン後に再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화가 켜져 있지만 기기가 로그인되어 있지 않아 이번 실행에서는 iCloud를 사용할 수 없습니다. 로그인한 뒤 다시 실행하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização está ativada, mas esta sessão não pode usar o iCloud porque o dispositivo não está conectado. Faça login e reinicie o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация включена, но при этом запуске iCloud недоступен, потому что на устройстве не выполнен вход. Войдите и перезапустите приложение."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہم وقت سازی فعال ہے، لیکن اس بار iCloud استعمال نہیں ہو سکتا کیونکہ ڈیوائس سائن ان نہیں ہے۔ سائن ان کے بعد ایپ دوبارہ کھولیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已启用，但本次启动无法使用 iCloud，因为设备未登录。请登录后重新启动。"
          }
        }
      }
    },
