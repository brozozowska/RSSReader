    "settings.opmlImportPreview.description" : {
      "comment" : "Description in the OPML import preview sheet.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عثر التطبيق على خلاصات في ملف OPML المحدد. راجع الملخص قبل إضافتها إلى قائمة الخلاصات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App hat Feeds in der ausgewählten OPML-Datei gefunden. Prüfe die Zusammenfassung, bevor du sie zu deiner Feed-Liste hinzufügst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App found feeds in the selected OPML file. Check the summary before adding them to your feed list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app encontró fuentes en el archivo OPML seleccionado. Revisa el resumen antes de añadirlas a tu lista de fuentes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه در فایل OPML انتخاب‌شده فیدهایی پیدا کرد. پیش از افزودن آن‌ها به فهرست فیدها، خلاصه را بررسی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app a trouvé des flux dans le fichier OPML sélectionné. Vérifiez le résumé avant de les ajouter à votre liste de flux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה מצאה פידים בקובץ OPML שנבחר. בדוק את הסיכום לפני ההוספה לרשימת הפידים שלך."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app ha trovato alcune fonti nel file OPML selezionato. Controlla il riepilogo prima di aggiungerle al tuo elenco di fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した OPML ファイル内にフィードが見つかりました。フィードリストに追加する前に概要を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 OPML 파일에서 피드를 찾았습니다. 피드 목록에 추가하기 전에 요약을 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app encontrou feeds no arquivo OPML selecionado. Revise o resumo antes de adicioná-los à sua lista de feeds."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение нашло ленты в выбранном OPML-файле. Проверьте сводку перед добавлением в список лент."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ نے منتخب OPML فائل میں فیڈز ڈھونڈ لی ہیں۔ انہیں اپنی فیڈز کی فہرست میں شامل کرنے سے پہلے خلاصہ دیکھ لیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用在所选 OPML 文件中找到了订阅源。添加到订阅源列表前请先查看摘要。"
          }
        }
      }
    },
    "settings.opmlImportPreview.footer" : {
      "comment" : "Footer in the OPML import preview sheet.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تخطي الخلاصات غير الصالحة والمكررة تلقائيًا. تتم إعادة استخدام المجلدات الموجودة؛ يتم إنشاء المجلدات المفقودة أثناء الاستيراد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungültige und doppelte Feeds werden automatisch übersprungen. Bestehende Ordner werden wiederverwendet; fehlende Ordner werden beim Import erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invalid and duplicate feeds are skipped automatically. Existing folders are reused; missing folders are created during import."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes no válidas y duplicadas se omiten automáticamente. Las carpetas existentes se reutilizan; las que falten se crearán durante la importación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فیدهای نامعتبر و تکراری خودکار رد می‌شوند. پوشه‌های موجود دوباره استفاده می‌شوند؛ پوشه‌های ناموجود هنگام وارد کردن ساخته می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les flux invalides et en double sont ignorés automatiquement. Les dossiers existants sont réutilisés ; les dossiers manquants sont créés pendant l’importation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פידים לא תקינים וכפולים ידולגו אוטומטית. תיקיות קיימות ישמשו מחדש; תיקיות חסרות ייווצרו במהלך הייבוא."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fonti non valide e duplicate vengono ignorate automaticamente. Le cartelle esistenti vengono riutilizzate; quelle mancanti verranno create durante l’importazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無効なフィードと重複フィードは自動的にスキップされます。既存のフォルダは再利用され、不足しているフォルダはインポート時に作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유효하지 않거나 중복된 피드는 자동으로 건너뜁니다. 기존 폴더는 재사용하고, 없는 폴더는 가져오는 동안 생성합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feeds inválidos e duplicados são ignorados automaticamente. Pastas existentes são reutilizadas; pastas ausentes são criadas durante a importação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некорректные и повторяющиеся ленты пропускаются автоматически. Существующие папки используются повторно, недостающие создаются при импорте."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نامعتبر اور مکرر فیڈز خود بخود چھوڑ دی جائیں گی۔ موجودہ فولڈرز دوبارہ استعمال ہوں گے؛ جو فولڈرز موجود نہ ہوں وہ درآمد کے دوران بن جائیں گے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无效和重复的订阅源会自动跳过。现有文件夹会被复用；缺少的文件夹会在导入时创建。"
          }
        }
      }
    },
